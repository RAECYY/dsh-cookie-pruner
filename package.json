{
  "name": "dsh-cookie-pruner",
  "version": "0.2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "description": "DSH desktop plugin that prevents the dsh-auth-* cookie pile-up behind HTTP 431 (Web authentication failed): measures the Cookies DB, caps new auth cookies at 3 days, and ships a one-shot offline cleanup script.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "cookie",
    "http-431",
    "auth",
    "cordis"
  ],
  "license": "MIT",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "cleanup-once.ps1",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "platforms": [
        "win32"
      ],
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
